<% content_for :meta_title, "Landed | #{@task.name}" %>

<%
  # ── Step state, read from the data instead of assumed order ──
  # Required steps count towards progress; optional ones never block anything.
  # A required step waits while its prerequisites (unlock_after_position) aren't done.
  done     = ->(item) { @user_checklist_items[item.id]&.completed }
  waiting  = ->(item) { !done.(item) && item.soft_locked_for?(@user_checklist_items, @manually_unlocked_ids, @checklist_items) }

  required = @checklist_items.reject(&:is_optional)
  optional = @checklist_items.select(&:is_optional)
  number   = required.each_with_index.to_h { |item, i| [item.id, i + 1] }

  now_steps   = required.reject { |i| waiting.(i) }
  later_steps = required.select { |i| waiting.(i) }
  focus_step  = now_steps.find { |i| !done.(i) }
  open_now    = now_steps.reject { |i| done.(i) }

  required_done = required.count { |i| done.(i) }
  all_done      = required.any? && required_done == required.size
  pct           = required.any? ? (required_done * 100.0 / required.size).round : 0

  waiting_for = ->(item) {
    nums = required.select { |i| i.position <= item.unlock_after_position && !done.(i) }.map { |i| number[i.id] }
    return "Unlocks when the steps above are done" if nums.empty?
    return "Unlocks when step #{nums.first} is done" if nums.size == 1
    consecutive = nums.each_cons(2).all? { |a, b| b == a + 1 }
    consecutive ? "Unlocks when steps #{nums.first} to #{nums.last} are done" : "Unlocks when steps #{nums.to_sentence(last_word_connector: ' and ')} are done"
  }

  first_sentence_of = ->(text) { text.to_s.split(/(?<=[.!?])\s+/).first.to_s }
  rest_of           = ->(text) { text.to_s.split(/(?<=[.!?])\s+/).drop(1).join(" ") }

  # Tips that name a step show on that step; the rest give "Before you start" its links
  tips         = Array(@task.expert_tips).select { |t| t.is_a?(Hash) }
  step_titles  = @checklist_items.map(&:title)
  tips_for     = ->(item) { tips.select { |t| t["step"] == item.title } }
  general_tips = tips.reject { |t| step_titles.include?(t["step"]) }

  if @task.due_date
    d = (@task.due_date - Date.today).to_i
    due_label, due_tone =
      if all_done then ["Done", "done"]
      elsif d < -30 then ["Overdue since #{@task.due_date.strftime('%B %Y')}", "overdue"]
      elsif d < 0 then ["#{-d} #{'day'.pluralize(-d)} overdue", "overdue"]
      elsif d == 0 then ["Due today", "soon"]
      elsif d <= 7 then ["Due #{@task.due_date.strftime('%b %-d')} · in #{d} #{'day'.pluralize(d)}", "soon"]
      else ["Due #{@task.due_date.strftime('%b %-d')}", "later"]
      end
  end

  svg = ->(paths, size = 16, stroke = 1.75) { %(<svg width="#{size}" height="#{size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="#{stroke}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">#{paths}</svg>).html_safe }
  i_check = svg.(%(<path d="M20 6 9 17l-5-5"/>), 16, 2)
  i_lock  = svg.(%(<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>), 14, 2)
  i_info  = svg.(%(<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>), 18)
  i_chev  = svg.(%(<path d="m6 9 6 6 6-6"/>), 18)
  i_out   = svg.(%(<path d="M7 17 17 7"/><path d="M7 7h10v10"/>), 16)
  i_cal   = svg.(%(<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>), 16)
  i_done  = svg.(%(<path d="M20 6 9 17l-5-5"/>), 22, 2.25)

  link_card = ->(tip) {
    url = tip["resource_url"].presence || (tip["resource_domain"].present? ? "https://#{tip['resource_domain']}" : nil)
    next "".html_safe if url.blank?
    domain = tip["resource_domain"].presence || URI.parse(url).host.to_s.sub(/\Awww\./, "")
    title  = tip["resource_title"].presence || tip["title"].presence || domain
    %(<a href="#{ERB::Util.h(url)}" target="_blank" rel="noopener" class="tp-link" aria-label="#{ERB::Util.h(title)} (opens #{ERB::Util.h(domain)} in a new tab)">
      <span class="tp-link__icon"><img src="https://www.google.com/s2/favicons?domain=#{ERB::Util.h(domain)}&amp;sz=64" alt="" width="18" height="18"></span>
      <span class="tp-link__text"><span class="tp-link__title">#{ERB::Util.h(title)}</span><span class="tp-link__domain">#{ERB::Util.h(domain)}</span></span>
      <span class="tp-link__out">#{i_out}</span>
    </a>).html_safe
  }
  general_links = general_tips.select { |t| t["resource_url"].present? || t["resource_domain"].present? }
                              .uniq { |t| t["resource_url"].presence || t["resource_domain"] }
%>

<div class="tp-page">
  <div class="tp-wrap">

    <nav class="tp-crumbs" aria-label="Breadcrumb">
      <%= link_to "Dashboard", dashboard_path %>
      <span aria-hidden="true">›</span>
      <% if @task.pillar %>
        <%= link_to @task.pillar.name, pillar_path(@task.pillar) %>
        <span aria-hidden="true">›</span>
      <% end %>
      <span class="tp-crumbs__current"><%= @task.name %></span>
    </nav>

    <%# ── HEADER ── %>
    <section class="tp-card tp-head">
      <div class="tp-head__top">
        <div class="tp-head__text">
          <div class="tp-tags">
            <% if @task.pillar %><span class="tp-pill tp-pill--<%= @task.pillar.slug %>"><%= @task.pillar.name %></span><% end %>
            <% if due_label %><span class="tp-due tp-due--<%= due_tone %>"><%= due_label %></span><% end %>
          </div>
          <h1 class="tp-title"><%= @task.name %></h1>
          <% if @task.description.present? %><p class="tp-desc"><%= @task.description %></p><% end %>
        </div>

        <% if @task.due_date && !all_done %>
          <%
            reminder_date = @task.due_date < Date.today ? Date.today + 1 : @task.due_date - 1
            reminder_date = Date.today if reminder_date < Date.today
            cal_title = CGI.escape("Landed: #{@task.name}")
          %>
          <div class="tp-remind">
            <button type="button" class="tp-btn tp-btn--secondary" aria-haspopup="true" aria-expanded="false" aria-controls="tp-remind-menu"
              onclick="const m=document.getElementById('tp-remind-menu'); const open=m.hidden; m.hidden=!open; this.setAttribute('aria-expanded', open); event.stopPropagation();">
              <%= i_cal %> Remind me
            </button>
            <div id="tp-remind-menu" class="tp-remind__menu" hidden onclick="event.stopPropagation()">
              <div class="tp-remind__date">
                <label for="tp-remind-date">Reminder date</label>
                <input type="date" id="tp-remind-date" value="<%= reminder_date.strftime('%Y-%m-%d') %>">
              </div>
              <a href="#" id="tp-remind-google" target="_blank" rel="noopener"><%= i_cal %> Google Calendar</a>
              <a href="#" id="tp-remind-outlook" target="_blank" rel="noopener"><%= i_cal %> Outlook</a>
              <a href="#" id="tp-remind-apple"><%= i_cal %> Apple Calendar</a>
            </div>
            <script>
              (function () {
                const menu = document.getElementById('tp-remind-menu');
                document.addEventListener('click', () => { if (menu) menu.hidden = true; });
                const input = document.getElementById('tp-remind-date');
                const title = "<%= cal_title %>";
                const update = () => {
                  const v = input.value, c = v.replace(/-/g, '');
                  document.getElementById('tp-remind-google').href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${c}/${c}`;
                  document.getElementById('tp-remind-outlook').href = `https://outlook.live.com/calendar/0/deeplink/compose?subject=${title}&startdt=${v}&enddt=${v}`;
                  document.getElementById('tp-remind-apple').href = `data:text/calendar;charset=utf8,${encodeURIComponent("BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nSUMMARY:<%= j @task.name %>\nDTSTART;VALUE=DATE:" + c + "\nDTEND;VALUE=DATE:" + c + "\nEND:VEVENT\nEND:VCALENDAR")}`;
                };
                input.addEventListener('change', update);
                update();
              })();
            </script>
          </div>
        <% end %>
      </div>

      <% if all_done %>
        <div class="tp-complete">
          <span class="tp-complete__icon"><%= i_done %></span>
          <div>
            <p class="tp-complete__title">All required steps are done</p>
            <p class="tp-complete__text"><%= optional.any? ? "Check the optional steps below in case any apply to you." : "This task is complete." %></p>
          </div>
          <%= link_to "Back to dashboard", dashboard_path, class: "tp-btn tp-btn--secondary tp-complete__btn" %>
        </div>
      <% elsif required.any? %>
        <div class="tp-progress">
          <div class="tp-progress__row">
            <p class="tp-progress__label"><%= required_done %> of <%= required.size %> steps done</p>
            <% if optional.any? %><p class="tp-progress__note"><%= optional.size %> optional <%= 'step'.pluralize(optional.size) %> if they apply to you</p><% end %>
          </div>
          <div class="tp-progress__bar" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="Task progress"><span style="width: <%= [pct, 4].max %>%"></span></div>
        </div>
      <% end %>

      <% if @task.why_it_matters.present? || general_links.any? %>
        <div class="tp-before">
          <span class="tp-before__icon"><%= i_info %></span>
          <div class="tp-before__body">
            <p class="tp-before__title">Before you start</p>
            <% if @task.why_it_matters.present? %><p class="tp-before__text"><%= @task.why_it_matters %></p><% end %>
            <% general_links.each do |tip| %>
              <%= link_card.(tip) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <%# ── START NOW ── %>
    <% if now_steps.any? %>
      <section class="tp-card" aria-labelledby="tp-now">
        <div class="tp-section-head">
          <h2 id="tp-now" class="tp-section-title">Start now</h2>
          <% if open_now.size > 1 %><span class="tp-section-note">These can happen at the same time</span><% end %>
        </div>
        <% if focus_step && open_now.size > 1 %>
          <p class="tp-section-intro">Start with step <%= number[focus_step.id] %>. The others can happen alongside it.</p>
        <% end %>

        <div class="tp-steps">
          <% now_steps.each do |item| %>
            <% if item == focus_step %>
              <div class="tp-focus">
                <div class="tp-focus__head">
                  <span class="tp-num tp-num--focus"><%= number[item.id] %></span>
                  <div class="tp-focus__text">
                    <div class="tp-focus__title-row">
                      <h3 class="tp-focus__title"><%= item.title %></h3>
                      <span class="tp-tag">Do this first</span>
                    </div>
                    <% if item.description.present? %><p class="tp-step__desc"><%= item.description %></p><% end %>
                    <% if item.action_note.present? %><p class="tp-step__desc"><%= item.action_note %></p><% end %>
                  </div>
                </div>
                <div class="tp-focus__actions">
                  <% tips_for.(item).each do |tip| %><%= link_card.(tip) %><% end %>
                  <div>
                    <%= button_to user_checklist_item_path(item), method: :patch, form: { data: { turbo: false } }, class: "tp-btn tp-btn--primary" do %>
                      <%= i_check %> Mark as done
                    <% end %>
                  </div>
                </div>
              </div>

            <% elsif done.(item) %>
              <div class="tp-row tp-row--done">
                <span class="tp-num tp-num--done" aria-label="Done"><%= i_check %></span>
                <span class="tp-row__text"><span class="tp-row__title"><%= item.title %></span></span>
                <span class="tp-done-chip">Done</span>
                <%= button_to "Undo", user_checklist_item_path(item), method: :patch, form: { data: { turbo: false } }, class: "tp-text-btn tp-text-btn--muted", aria: { label: "Mark #{item.title} as not done" } %>
              </div>

            <% else %>
              <details class="tp-row">
                <summary>
                  <span class="tp-num"><%= number[item.id] %></span>
                  <span class="tp-row__text">
                    <span class="tp-row__title"><%= item.title %></span>
                    <span class="tp-row__desc"><%= item.description %></span>
                  </span>
                  <span class="tp-row__chev"><%= i_chev %></span>
                </summary>
                <div class="tp-row__more">
                  <% if item.action_note.present? %><p class="tp-step__desc"><%= item.action_note %></p><% end %>
                  <% tips_for.(item).each do |tip| %><%= link_card.(tip) %><% end %>
                  <%= button_to user_checklist_item_path(item), method: :patch, form: { data: { turbo: false } }, class: "tp-btn tp-btn--secondary" do %>
                    <%= i_check %> Mark as done
                  <% end %>
                </div>
              </details>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# ── STEPS THAT WAIT FOR OTHERS ── %>
    <% if later_steps.any? %>
      <section class="tp-card" aria-labelledby="tp-later">
        <h2 id="tp-later" class="tp-section-title tp-section-title--solo">After that</h2>
        <div class="tp-steps">
          <% later_steps.each do |item| %>
            <div class="tp-row tp-row--waiting">
              <span class="tp-num tp-num--waiting"><%= i_lock %></span>
              <span class="tp-row__text">
                <span class="tp-row__title"><%= number[item.id] %> · <%= item.title %></span>
                <span class="tp-row__desc"><%= rest_of.(item.description).presence || first_sentence_of.(item.description) %> <%= waiting_for.(item) %>.</span>
              </span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# ── OPTIONAL ── %>
    <% if optional.any? %>
      <section class="tp-card" aria-labelledby="tp-optional">
        <div class="tp-section-head">
          <h2 id="tp-optional" class="tp-section-title"><%= required.any? ? "Only if it applies to you" : "Pick what applies to you" %></h2>
          <span class="tp-section-note"><%= required.any? ? "Not counted in your progress" : "None of these are required" %></span>
        </div>
        <ul class="tp-optional">
          <% optional.each do |item| %>
            <li class="tp-optional__item">
              <% if done.(item) %>
                <span class="tp-num tp-num--done" aria-label="Done"><%= i_check %></span>
              <% else %>
                <span class="tp-num tp-num--optional" aria-hidden="true"></span>
              <% end %>
              <span class="tp-row__text">
                <span class="tp-row__title"><%= item.title %></span>
                <span class="tp-row__desc"><%= first_sentence_of.(item.description) %></span>
              </span>
              <%= button_to (done.(item) ? "Undo" : "Mark as done"), user_checklist_item_path(item), method: :patch, form: { data: { turbo: false } }, class: "tp-text-btn#{' tp-text-btn--muted' if done.(item)}" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

  </div>
</div>
