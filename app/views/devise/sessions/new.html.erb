<% content_for :meta_title, "Landed | Sign in" %>

<div class="auth-page">
  <%= render "devise/shared/auth_header" %>

  <div class="auth-shell">
    <div class="auth-heading">
      <h1>Welcome back</h1>
      <p>Sign in to pick up where you left off.</p>
    </div>

    <%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "auth-card" do |f| %>
      <div class="auth-field">
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "auth-input" %>
      </div>

      <div class="auth-field">
        <div class="auth-label-row">
          <%= f.label :password, "Password", class: "auth-label" %>
          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "auth-label-link" %>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", class: "auth-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="auth-remember">
          <%= f.check_box :remember_me %>
          <span>Keep me signed in</span>
        </label>
      <% end %>

      <button type="submit" class="auth-button">
        Sign in <%= lucide_icon("arrow_right", size: 16) %>
      </button>
    <% end %>

    <% if devise_mapping.registerable? %>
      <p class="auth-switch">
        New to Landed? <%= link_to "Create an account", new_registration_path(resource_name) %>
      </p>
    <% end %>
  </div>
</div>
