<% content_for :meta_title, "Landed | Change password" %>

<div class="auth-page">
  <%= render "devise/shared/auth_header" %>

  <div class="auth-shell">
    <div class="auth-heading">
      <h1>Set a new password</h1>
      <p>Choose something you haven't used here before.</p>
    </div>

    <%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: "auth-card" do |f| %>
      <%= render "devise/shared/auth_errors" %>
      <%= f.hidden_field :reset_password_token %>

      <div class="auth-field">
        <%= f.label :password, "New password", class: "auth-label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "auth-input" %>
        <% if @minimum_password_length %>
          <p class="auth-hint">At least <%= @minimum_password_length %> characters</p>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "Confirm new password", class: "auth-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
      </div>

      <button type="submit" class="auth-button">Update password</button>
    <% end %>
  </div>
</div>
