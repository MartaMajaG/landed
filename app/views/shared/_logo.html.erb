<%# Landed logo: the L tile (same mark as the sidebar and the favicon) plus the wordmark. locals: size (tile height in px) %>
<% size = local_assigns.fetch(:size, 24) %>
<span class="landed-logo">
  <span class="landed-logo__mark" style="width:<%= size %>px; height:<%= size %>px; font-size:<%= (size * 0.5).round %>px; border-radius:<%= (size * 0.3).round %>px;" aria-hidden="true">L</span>
  <span class="landed-logo__word">Landed</span>
</span>
