<% content_for :meta_title, "Landed | Alerts" %>

<%
  today = @feed.today

  status_for = ->(due) {
    d = (due - today).to_i
    if d < -30 then ["Overdue since #{due.strftime('%B %Y')}", "overdue"]
    elsif d < 0 then ["#{-d} #{'day'.pluralize(-d)} overdue", "overdue"]
    elsif d == 0 then ["Due today", "soon"]
    elsif d == 1 then ["Due tomorrow", "soon"]
    elsif d <= 7 then ["In #{d} days", "soon"]
    else ["Due #{due.strftime('%b %-d')}", "later"]
    end
  }

  icon_task = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>'.html_safe
  icon_doc  = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h8"/><path d="M8 17h8"/></svg>'.html_safe
  icon_chev = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>'.html_safe
  icon_ok   = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'.html_safe

  groups = [
    ["Needs attention", "Past their deadline", @feed.overdue],
    ["This week", "Due in the next 7 days", @feed.this_week],
    ["Coming up", "Later this month", @feed.coming_up]
  ].reject { |_, _, list| list.empty? }

  summary_parts = []
  summary_parts << "#{@feed.overdue.size} overdue" if @feed.overdue.any?
  summary_parts << "#{@feed.this_week.size} due this week" if @feed.this_week.any?
  summary_parts << "#{@feed.coming_up.size} coming up" if @feed.coming_up.any?
%>

<div class="alerts-page">
  <div class="alerts-wrap">

    <header class="alerts-head">
      <h1 class="alerts-title">Alerts</h1>
      <p class="alerts-sub">
        <%= summary_parts.any? ? summary_parts.to_sentence.upcase_first + "." : "Deadlines from your tasks and scanned documents show up here." %>
      </p>
    </header>

    <% if groups.empty? %>
      <section class="alerts-card alerts-empty">
        <span class="alerts-empty__icon"><%= icon_ok %></span>
        <h2 class="alerts-group__title">You're all caught up</h2>
        <p class="alerts-sub">Nothing is due in the next 30 days. We'll let you know when something comes up.</p>
        <%= link_to "Back to dashboard", dashboard_path, class: "alerts-btn" %>
      </section>
    <% end %>

    <% groups.each do |title, sub, list| %>
      <section class="alerts-card" aria-labelledby="alerts-<%= title.parameterize %>">
        <div class="alerts-group__head">
          <h2 class="alerts-group__title" id="alerts-<%= title.parameterize %>"><%= title %> <span class="alerts-count"><%= list.size %></span></h2>
          <p class="alerts-group__sub"><%= sub %></p>
        </div>
        <ul class="alerts-list">
          <% list.each do |item| %>
            <% label, tone = status_for.(item.due_date) %>
            <% path = item.kind == :task ? task_path(item.record) : chat_path(item.record) %>
            <li>
              <%= link_to path, class: "alert-row" do %>
                <span class="alert-row__icon alert-row__icon--<%= item.category_slug || 'uncategorized' %>"><%= item.kind == :task ? icon_task : icon_doc %></span>
                <span class="alert-row__body">
                  <span class="alert-row__title"><%= item.title %></span>
                  <span class="alert-row__meta"><%= [item.category, item.due_date.strftime("%b %-d, %Y")].compact.join(" · ") %></span>
                </span>
                <span class="alert-chip alert-chip--<%= tone %>"><%= label %></span>
                <span class="alert-row__chev"><%= icon_chev %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

  </div>
</div>
