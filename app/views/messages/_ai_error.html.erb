<%# Shown instead of an AI reply when the answer failed. Same id as the loading bubble, so a retry replaces it. %>
<div id="ai-loading-<%= user_message.id %>" style="display:flex; gap:8px; align-items:flex-start;"
     data-controller="ai-reply" data-ai-reply-url-value="<%= regenerate_chat_message_path(chat, user_message) %>">
  <div style="width:28px; height:28px; background:#FDE4E1; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#B42318;">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
  </div>
  <div role="alert" style="background:#FEF3F2; border:1px solid #FBD5D1; padding:10px 14px; border-radius:4px 18px 18px 18px; max-width:75%; font-size:14px; line-height:1.5;">
    <p style="margin:0; font-weight:600; color:#912018;">I couldn't answer that just now.</p>
    <p style="margin:2px 0 8px; color:#7A271A;">Your question is saved. Try again in a moment.</p>
    <button type="button" data-action="ai-reply#retry"
            style="display:inline-flex; align-items:center; gap:6px; min-height:36px; padding:0 12px; border:1px solid #FBD5D1; border-radius:10px; background:#fff; color:#B42318; font-size:14px; font-weight:600; cursor:pointer;">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M8 16H3v5"/></svg> Try again
    </button>
  </div>
</div>
