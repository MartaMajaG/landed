  <div class="ai-reply" style="background:#fff; border:1px solid #C8BCF5; color:#1A1A2E; font-size:14px; line-height:1.6; padding:10px 14px; border-radius:4px 18px 18px 18px; max-width:75%;"><%= format_ai_reply(content) %></div>
</div>
