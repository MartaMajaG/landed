<%# 1. Append the user's message bubble (same style as on page load) %>
<%= turbo_stream.append "chat-messages-#{@chat.id}" do %>
  <div style="display:flex; justify-content:flex-end;">
    <div style="background:#6B56E2; color:#fff; font-size:14px; line-height:1.6; padding:10px 14px; border-radius:18px 4px 18px 18px; max-width:75%;"><%= @user_message.content %></div>
  </div>
<% end %>

<%# 2. Append a loading bubble, replaced by the AI reply when AiReplyJob finishes %>
<%= turbo_stream.append "chat-messages-#{@chat.id}" do %>
  <%= render "messages/ai_loading", chat: @chat, user_message: @user_message %>
<% end %>

<%# 3. Scroll chat to bottom %>
<%= turbo_stream.append "chat-messages-#{@chat.id}" do %>
  <script>
    (function() {
      const el = document.getElementById('chat-messages-<%= @chat.id %>');
      if (el) el.scrollTop = el.scrollHeight;
    })();
  </script>
<% end %>
