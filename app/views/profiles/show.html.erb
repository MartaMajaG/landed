<% content_for :meta_title, "Landed | Profile" %>

<%
  full_name = [@profile.first_name, @profile.last_name].compact_blank.join(" ")
  city      = @profile.city
  arrival   = @profile.arrival_date

  visa_labels = {
    "student"     => ["Student visa", "Studying in Germany"],
    "employment"  => ["Work visa", "Employed in Germany"],
    "freelancer"  => ["Freelance visa", "Self-employed in Germany"],
    "eu_citizen"  => ["EU citizen", "No visa needed"]
  }
  visa_label, visa_sub = visa_labels[@profile.visa_status]

  housing_label, housing_sub =
    if @profile.has_home.nil? then [nil, nil]
    elsif @profile.has_home then ["Found a place", "Housing sorted"]
    else ["Still looking", "We'll help you find one"]
    end

  # Same stages as the dashboard journey
  stages = [
    ["pre_departure", "Pre-departure"],
    ["arrival",       "Arrival"],
    ["settling_in",   "Settling in"],
    ["established",   "Established"]
  ]
  current_stage =
    if arrival.nil? || Date.today < arrival then "pre_departure"
    elsif Date.today < arrival + 30.days then "arrival"
    elsif Date.today < arrival + 6.months then "settling_in"
    else "established"
    end
  current_index = stages.index { |key, _| key == current_stage }

  arrival_sub =
    if arrival.nil? then nil
    elsif arrival > Date.today then "In #{distance_of_time_in_words(Date.today, arrival)}"
    elsif arrival == Date.today then "Today"
    else "#{distance_of_time_in_words(arrival, Date.today).capitalize} ago"
    end

  icon = ->(paths) { %(<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">#{paths}</svg>).html_safe }
  icon_pin   = icon.(%(<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>))
  icon_plane = icon.(%(<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>))
  icon_pass  = icon.(%(<rect x="4" y="2" width="16" height="20" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M8 17h8"/>))
  icon_home  = icon.(%(<path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>))
  icon_edit  = icon.(%(<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>))
  icon_check = icon.(%(<path d="M20 6 9 17l-5-5"/>))

  details = [
    { icon: icon_pin,   label: "Destination",      value: city ? "#{city.name}, #{city.country}" : nil, sub: nil, empty: "Not selected yet" },
    { icon: icon_plane, label: "Arrival date",     value: arrival&.strftime("%B %-d, %Y"), sub: arrival_sub, empty: "Not added yet" },
    { icon: icon_pass,  label: "Residency status", value: visa_label, sub: visa_sub, empty: "Not selected yet" },
    { icon: icon_home,  label: "Housing",          value: housing_label, sub: housing_sub, empty: "Not selected yet" }
  ]
%>

<div class="prof-page">
  <div class="prof-wrap">

    <section class="prof-card prof-hero">
      <div class="prof-hero__top">
        <div class="prof-identity">
          <img src="https://images.unsplash.com/photo-1592621385612-4d7129426394?q=80&w=400&auto=format&fit=crop" alt="" class="prof-avatar">
          <div>
            <h1 class="prof-name"><%= full_name.presence || "Your profile" %></h1>
            <p class="prof-meta">
              <% if city %>Moving to <%= city.name %>, <%= city.country %><% else %>Add your destination to personalise your plan<% end %>
            </p>
          </div>
        </div>
        <%= link_to edit_profile_path, class: "prof-btn" do %>
          <%= icon_edit %> Edit profile
        <% end %>
      </div>

      <div class="prof-journey" aria-label="Relocation journey">
        <p class="prof-label">Your journey</p>
        <ol class="prof-steps">
          <% stages.each_with_index do |(key, name), i| %>
            <% state = i < current_index ? "done" : (i == current_index ? "current" : "next") %>
            <li class="prof-step prof-step--<%= state %>" <%= 'aria-current="step"'.html_safe if state == "current" %>>
              <span class="prof-step__dot"><%= icon_check if state == "done" %></span>
              <span class="prof-step__name"><%= name %></span>
            </li>
          <% end %>
        </ol>
      </div>
    </section>

    <section class="prof-card">
      <div class="prof-section-head">
        <h2 class="prof-title">Relocation details</h2>
        <p class="prof-sub">Landed uses these to build your tasks and deadlines.</p>
      </div>
      <div class="prof-grid">
        <% details.each do |d| %>
          <div class="prof-detail">
            <span class="prof-detail__icon"><%= d[:icon] %></span>
            <div>
              <p class="prof-detail__label"><%= d[:label] %></p>
              <% if d[:value].present? %>
                <p class="prof-detail__value"><%= d[:value] %></p>
                <% if d[:sub].present? %><p class="prof-detail__sub"><%= d[:sub] %></p><% end %>
              <% else %>
                <p class="prof-detail__value prof-detail__value--empty"><%= d[:empty] %></p>
                <%= link_to "Add it", edit_profile_path, class: "prof-link" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section class="prof-card prof-account">
      <div>
        <h2 class="prof-title">Account</h2>
        <p class="prof-sub">Signed in as <strong><%= current_user.email %></strong></p>
      </div>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "prof-btn prof-btn--quiet" %>
    </section>

  </div>
</div>
