<% content_for :meta_title, "Landed | Set up your move" %>

<div class="ob"
     data-controller="onboarding"
     data-onboarding-tasks-value="<%= @plan_tasks.to_json %>"
     data-onboarding-icons-value="<%= ApplicationHelper::PILLAR_ICONS.to_json %>"
     data-onboarding-current-step-value="1"
     data-onboarding-total-steps-value="4">

  <header class="ob-header">
    <%= link_to root_path, class: "lp-brand" do %>
      <%= render "shared/logo", size: 24 %>
    <% end %>
    <span class="ob-header__step" data-onboarding-target="stepLabel">Question 1 of 4</span>
    <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "ob-header__link" %>
  </header>
  <div class="ob-progress" aria-hidden="true"><span data-onboarding-target="progressBar"></span></div>

  <%= form_with model: @profile, url: onboarding_path, method: :patch, class: "ob-form",
                data: { onboarding_target: "form" } do |f| %>

    <div class="ob-stage" data-onboarding-target="stage">
      <div class="ob-main">
        <% if @profile.errors.any? %>
          <div class="ob-alert" role="alert"><%= @profile.errors.full_messages.to_sentence %></div>
        <% end %>

        <%# ── 1. City ── %>
        <section class="ob-step" data-onboarding-target="step" aria-labelledby="ob-q1">
          <h1 id="ob-q1">Where in Germany are you moving?</h1>
          <p class="ob-lede">Each city runs its own offices and booking systems, so your checklist depends on it.</p>

          <div class="ob-options ob-options--3" role="radiogroup" aria-labelledby="ob-q1">
            <% @city_names.each do |city_name| %>
              <% city = @cities_by_name[city_name] %>
              <% details = @city_details.fetch(city_name) %>
              <% input_id = "profile_city_id_#{city_name.parameterize}" %>
              <div class="ob-option">
                <%= f.radio_button :city_id, city&.id, id: input_id, required: true, disabled: city.nil?,
                      class: "ob-option__input",
                      data: { action: "change->onboarding#choose", summary_key: "city", summary_label: city_name } %>
                <label class="ob-option__card" for="<%= input_id %>">
                  <span class="ob-option__icon"><%= lucide_icon(details[:icon], size: 20) %></span>
                  <span class="ob-option__title"><%= city_name %></span>
                  <span class="ob-option__desc"><%= details[:description] %></span>
                  <span class="ob-option__tick"><%= lucide_icon("check", size: 12) %></span>
                </label>
              </div>
            <% end %>
          </div>

          <div class="ob-actions">
            <button type="button" class="ob-btn" data-action="onboarding#next">Continue <%= lucide_icon("arrow_right", size: 16) %></button>
            <span class="ob-hint">or press <kbd>Enter</kbd></span>
          </div>
        </section>

        <%# ── 2. Arrival date ── %>
        <section class="ob-step" data-onboarding-target="step" aria-labelledby="ob-q2" hidden>
          <h1 id="ob-q2">When do you arrive?</h1>
          <p class="ob-lede">Most German deadlines count from the day you move in. We'll date your checklist from here.</p>

          <%= f.hidden_field :arrival_date, data: { onboarding_target: "dateInput" } %>

          <div class="ob-quick" role="group" aria-label="Quick picks">
            <button type="button" class="ob-chip" data-days="0"  data-action="onboarding#quickDate">I'm already here</button>
            <button type="button" class="ob-chip" data-days="14" data-action="onboarding#quickDate">In 2 weeks</button>
            <button type="button" class="ob-chip" data-days="30" data-action="onboarding#quickDate">In a month</button>
            <button type="button" class="ob-chip" data-days="90" data-action="onboarding#quickDate">In 3 months</button>
          </div>

          <div class="ob-cal">
            <div class="ob-cal__head">
              <button type="button" class="ob-cal__nav" aria-label="Previous month" data-action="onboarding#previousMonth"><%= lucide_icon("chevron_left", size: 18) %></button>
              <h2 data-onboarding-target="monthLabel"></h2>
              <button type="button" class="ob-cal__nav" aria-label="Next month" data-action="onboarding#nextMonth"><%= lucide_icon("chevron_right", size: 18) %></button>
            </div>
            <div class="ob-cal__weekdays">
              <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %><span><%= day %></span><% end %>
            </div>
            <div class="ob-cal__grid" data-onboarding-target="calendarGrid"></div>
          </div>

          <div class="ob-actions">
            <button type="button" class="ob-btn" data-action="onboarding#next">Continue <%= lucide_icon("arrow_right", size: 16) %></button>
            <button type="button" class="ob-btn ob-btn--ghost" data-action="onboarding#previous"><%= lucide_icon("arrow_left", size: 16) %> Back</button>
            <button type="button" class="ob-skip" data-action="onboarding#skipDate">I don't know yet</button>
          </div>
        </section>

        <%# ── 3. Visa ── %>
        <section class="ob-step" data-onboarding-target="step" aria-labelledby="ob-q3" hidden>
          <h1 id="ob-q3">What brings you to Germany?</h1>
          <p class="ob-lede">Your reason for moving decides which permits and registrations you need.</p>

          <div class="ob-options ob-options--2" role="radiogroup" aria-labelledby="ob-q3">
            <% @visa_options.each do |option| %>
              <% input_id = "profile_visa_status_#{option[:value]}" %>
              <div class="ob-option">
                <%= f.radio_button :visa_status, option[:value], id: input_id, required: true,
                      class: "ob-option__input",
                      data: { action: "change->onboarding#choose", summary_key: "visa", summary_label: option[:title] } %>
                <label class="ob-option__card ob-option__card--row" for="<%= input_id %>">
                  <span class="ob-option__icon"><%= lucide_icon(option[:icon], size: 20) %></span>
                  <span>
                    <span class="ob-option__title"><%= option[:title] %></span>
                    <span class="ob-option__desc"><%= option[:description] %></span>
                  </span>
                  <span class="ob-option__tick"><%= lucide_icon("check", size: 12) %></span>
                </label>
              </div>
            <% end %>
          </div>

          <div class="ob-actions">
            <button type="button" class="ob-btn" data-action="onboarding#next">Continue <%= lucide_icon("arrow_right", size: 16) %></button>
            <button type="button" class="ob-btn ob-btn--ghost" data-action="onboarding#previous"><%= lucide_icon("arrow_left", size: 16) %> Back</button>
          </div>
        </section>

        <%# ── 4. Housing ── %>
        <section class="ob-step" data-onboarding-target="step" aria-labelledby="ob-q4" hidden>
          <h1 id="ob-q4">Do you have a place to live yet?</h1>
          <p class="ob-lede">You can only register your address once you have one, so this changes what comes first.</p>

          <div class="ob-options ob-options--2" role="radiogroup" aria-labelledby="ob-q4">
            <% @home_options.each do |option| %>
              <% input_id = "profile_has_home_#{option[:value]}" %>
              <div class="ob-option">
                <%= f.radio_button :has_home, option[:value], id: input_id, required: true,
                      class: "ob-option__input",
                      data: { action: "change->onboarding#choose", summary_key: "home", summary_label: option[:value] == "true" ? "Has a place" : "Still looking" } %>
                <label class="ob-option__card" for="<%= input_id %>">
                  <span class="ob-option__icon"><%= lucide_icon(option[:icon], size: 20) %></span>
                  <span class="ob-option__title"><%= option[:title] %></span>
                  <span class="ob-option__desc"><%= option[:description] %></span>
                  <span class="ob-option__tick"><%= lucide_icon("check", size: 12) %></span>
                </label>
              </div>
            <% end %>
          </div>

          <div class="ob-actions">
            <button type="button" class="ob-btn" data-action="onboarding#build">Build my plan <%= lucide_icon("sparkles", size: 16) %></button>
            <button type="button" class="ob-btn ob-btn--ghost" data-action="onboarding#previous"><%= lucide_icon("arrow_left", size: 16) %> Back</button>
          </div>
        </section>
      </div>

      <%# ── Live summary ── %>
      <aside class="ob-summary" aria-label="Your move so far">
        <div class="ob-summary__head">
          <h2>Your move</h2>
          <p>Updates as you answer</p>
        </div>
        <ul class="ob-summary__rows">
          <% [["city", "Destination", "pin"], ["date", "Arrival", "calendar"], ["visa", "Reason for moving", "passport"], ["home", "Housing", "home"]].each do |key, label, icon| %>
            <li class="ob-fact" data-onboarding-target="fact" data-key="<%= key %>">
              <span class="ob-fact__icon">
                <span class="ob-fact__idle"><%= lucide_icon(icon, size: 16) %></span>
                <span class="ob-fact__done"><%= lucide_icon("check", size: 16) %></span>
              </span>
              <span>
                <span class="ob-fact__label"><%= label %></span>
                <span class="ob-fact__value">Not set yet</span>
              </span>
            </li>
          <% end %>
        </ul>
        <div class="ob-summary__foot">
          <b data-onboarding-target="taskCount">–</b>
          <span>tasks in your checklist</span>
        </div>
      </aside>
    </div>

    <%# ── Building the plan ── %>
    <section class="ob-gen" data-onboarding-target="generating" hidden>
      <h1>Building your plan</h1>
      <ul>
        <li data-onboarding-target="genLine"><span class="ob-gen__dot"><%= lucide_icon("check", size: 12) %></span>Reading your answers</li>
        <li data-onboarding-target="genLine"><span class="ob-gen__dot"><%= lucide_icon("check", size: 12) %></span><span data-onboarding-target="genCity">Matching offices in your city</span></li>
        <li data-onboarding-target="genLine"><span class="ob-gen__dot"><%= lucide_icon("check", size: 12) %></span>Ordering tasks so each one unlocks the next</li>
        <li data-onboarding-target="genLine"><span class="ob-gen__dot"><%= lucide_icon("check", size: 12) %></span>Setting deadlines from your arrival date</li>
      </ul>
    </section>

    <%# ── Plan preview ── %>
    <section class="ob-plan" data-onboarding-target="plan" hidden>
      <div class="ob-plan__head">
        <div>
          <h1 data-onboarding-target="planTitle">Your plan is ready</h1>
          <p data-onboarding-target="planLede"></p>
        </div>
        <div class="ob-plan__stats" data-onboarding-target="planStats"></div>
      </div>
      <div class="ob-plan__phases" data-onboarding-target="planBody"></div>
      <div class="ob-plan__cta" data-onboarding-target="planCta">
        <p data-onboarding-target="planNext"></p>
        <button type="submit" class="ob-btn">Open my dashboard <%= lucide_icon("arrow_right", size: 16) %></button>
      </div>
    </section>
  <% end %>
</div>
