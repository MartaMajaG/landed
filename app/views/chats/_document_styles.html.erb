<%# Shared by the document page and the landing page's scanner preview %>
<style>
  .lucide-icon { display: inline-flex; align-items: center; flex-shrink: 0; }
  .ai-reply p { margin: 0 0 8px; }
  .ai-reply p:last-child { margin-bottom: 0; }

  .doc-page { padding: 24px 0 40px; }
  .doc-wrap { max-width: 1240px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

  .doc-card {
    background: #fff; border: 1px solid #ECEBF3; border-radius: 20px;
    box-shadow: 0 4px 14px -10px rgba(91,80,232,0.35);
  }
  .doc-value { color: #4433B8; font-weight: 600; }

  /* Header */
  .doc-head { padding: 28px 32px 24px; display: flex; flex-direction: column; gap: 20px; }
  .doc-head__top { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .doc-tags { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .doc-tag { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: #F0F2F7; color: #4B5563; }
  .doc-tag--brand { background: #EEEBFD; color: #4433B8; }
  /* Brief ring on the card that just answered. Uses outline, not box-shadow,
     so it does not fight the card's own resting shadow and costs no layout. */
  @keyframes doc-halo {
    0%   { outline-color: rgba(107, 86, 226, 0.55); }
    70%  { outline-color: rgba(107, 86, 226, 0.22); }
    100% { outline-color: rgba(107, 86, 226, 0); }
  }
  .doc-card--halo { outline: 3px solid rgba(107, 86, 226, 0); outline-offset: 3px; animation: doc-halo 1.6s ease-out forwards; }
  @media (prefers-reduced-motion: reduce) {
    .doc-card--halo { animation: none; outline-color: rgba(107, 86, 226, 0.45); }
  }

  /* The deadline is the third line of the title block: what it is, what it is
     called in German, when it is due. Not a pill, because a pill row answers
     "what kind of document is this" and a deadline answers "when must you act". */
  .doc-deadline { display: flex; align-items: center; gap: 8px; margin: 10px 0 0; font-size: 14px; }
  .doc-deadline__icon svg { width: 16px; height: 16px; }
  .doc-deadline__meta::before { content: "\00B7"; margin-right: 8px; opacity: 0.55; }
  .doc-deadline__meta { opacity: 0.8; }
  .doc-deadline--calm { color: #4B5563; }
  .doc-deadline--soon { color: #9A5504; }
  .doc-processed { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #5F6775; margin-left: 4px; }
  .doc-title { margin: 0; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: 32px; font-weight: 700; letter-spacing: -0.5px; line-height: 1.15; color: #1A1535; }
  .doc-subtitle { margin: 8px 0 0; font-size: 14px; color: #5F6775; font-style: italic; }

  .doc-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .doc-btn {
    height: 44px; padding: 0 16px; border-radius: 10px; font-size: 14px; font-weight: 600;
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; transition: background 0.15s ease;
  }
  .doc-btn--secondary { border: 1px solid #D0C2F5; background: #EEEBFD; color: #4433B8; }
  .doc-btn--secondary:hover { background: #E4E1FD; }
  .doc-btn--primary { border: none; background: #6B56E2; color: #fff; }
  .doc-btn--primary:hover { background: #5B47D6; }

  /* Deadline banner */
  .doc-banner { display: flex; align-items: center; gap: 10px; border-radius: 12px; padding: 10px 14px; border: 1px solid; }
  .doc-banner__icon { width: 28px; height: 28px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .doc-banner__svg svg { width: 16px; height: 16px; }
  .doc-banner__title { margin: 0; font-size: 14px; font-weight: 600; }
  .doc-banner__text { margin: 0; font-size: 14px; }
  .doc-banner__text::before { content: "\00B7"; margin-right: 8px; opacity: 0.55; }
  .doc-banner--overdue { background: #FEE2E2; border-color: #FEE2E2; }
  .doc-banner--overdue .doc-banner__icon { background: #FEE2E2; color: #C01C1C; }
  .doc-banner--overdue .doc-banner__title { color: #C01C1C; }
  .doc-banner--overdue .doc-banner__text { color: #C01C1C; }
  .doc-banner--soon { background: #FEF3C7; border-color: #FEF3C7; }
  .doc-banner--soon .doc-banner__icon { background: #FEF3C7; color: #9A5504; }
  .doc-banner--soon .doc-banner__title { color: #9A5504; }
  .doc-banner--soon .doc-banner__text { color: #9A5504; }
  .doc-banner--calm { background: #FAFAFC; border-color: #E6E0FB; }
  .doc-banner--calm .doc-banner__icon { background: #EEEBFD; color: #4433B8; }
  .doc-banner--calm .doc-banner__title { color: #1A1535; }
  .doc-banner--calm .doc-banner__text { color: #4B5563; }

  /* Stat strip */
  .doc-stats { display: grid; border-top: 1px solid #ECEBF3; background: #FAFAFC; border-radius: 0 0 20px 20px; }
  .doc-stat { padding: 20px 32px; display: flex; flex-direction: column; gap: 6px; }
  .doc-stat + .doc-stat { border-left: 1px solid #ECEBF3; }
  .doc-stat__label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #5F6775; }
  .doc-stat__value { margin: 0; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: 28px; font-weight: 700; letter-spacing: -0.4px; color: #1A1535; }
  .doc-stat__sub { margin: 0; font-size: 14px; color: #4B5563; }

  /* Two columns */
  .doc-columns { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px; align-items: start; }
  .doc-section-title { margin: 0; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: 17px; font-weight: 700; color: #1A1535; }
  .doc-link { font-size: 14px; font-weight: 600; color: #6B56E2; text-decoration: none; display: inline-flex; align-items: center; min-height: 24px; gap: 6px; }
  .doc-link:hover { color: #4433B8; }

  .doc-left { padding: 24px; display: flex; flex-direction: column; gap: 20px; box-sizing: border-box; }
  .doc-peek {
    display: block; position: relative; height: 260px; overflow: hidden;
    background: #fff; border: 1px solid #ECEBF3; border-radius: 16px;
  }
  .doc-peek img { width: 100%; height: auto; display: block; transition: transform 0.3s ease; }
  .doc-peek::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 90px;
    background: linear-gradient(to bottom, rgba(255,255,255,0), #fff);
  }
  .doc-peek:hover img { transform: translateY(-6px); }
  .doc-file { background: #FAFAFC; border: 1px solid #ECEBF3; border-radius: 16px; min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #4B5563; font-size: 14px; }

  .doc-details { border-top: 1px solid #ECEBF3; padding-top: 16px; }
  .doc-details dl { margin: 10px 0 0; }
  .doc-details__row { padding: 12px 0; border-bottom: 1px solid #ECEBF3; }
  .doc-details__row:last-child { border-bottom: none; padding-bottom: 0; }
  .doc-details dt { font-size: 12px; font-weight: 500; color: #5F6775; margin: 0 0 2px; }
  .doc-details dd { margin: 0; font-size: 14px; font-weight: 600; color: #1A1535; line-height: 1.5; }
  .doc-details dd span { font-weight: 400; color: #5F6775; }
  .doc-notes { border-top: 1px solid #ECEBF3; padding-top: 6px; }
  .doc-notes__head { display: flex; justify-content: space-between; align-items: center; }
  .doc-label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #5F6775; }
  .doc-notes__add { min-height: 44px; padding: 0 4px; border: none; background: transparent; color: #6B56E2; font-size: 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .doc-notes__add:hover { color: #4433B8; }
  .doc-notes__empty { margin: 0; font-size: 14px; color: #4B5563; line-height: 1.6; }
  .doc-notes__list:not(:empty) + .doc-notes__empty { display: none; }

  .note-panel { display: none; margin-top: 8px; border: 1px solid #6B56E2; border-radius: 16px; padding: 12px; background: #fff; }
  .note-panel.open { display: block; }
  .note-textarea {
    width: 100%; font-size: 14px; font-family: inherit; color: #1A1535; background: #FAFAFC;
    border: 1px solid #E4E1FD; border-radius: 12px; padding: 9px 12px; resize: none; line-height: 1.6; outline: none;
  }
  .note-textarea:focus { border-color: #6B56E2; background: #fff; }
  .note-item {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
    padding: 10px 12px; margin-top: 8px; background: #FAFAFC; border-radius: 12px; border: 1px solid #EEEBFD;
  }
  .note-item-text { font-size: 14px; color: #1A1535; line-height: 1.6; margin: 0; }
  .note-item-meta { font-size: 12px; color: #5F6775; margin-top: 3px; }
  .note-delete-btn { background: none; border: none; cursor: pointer; color: #5F6775; padding: 4px; min-width: 24px; flex-shrink: 0; }
  .note-delete-btn:hover { color: #C01C1C; }

  /* Assistant: stays in view while the page scrolls */
  .doc-assistant {
    position: sticky; top: 24px; height: calc(100vh - 48px); min-height: 520px;
    display: flex; flex-direction: column; overflow: hidden;
  }
  .doc-assistant__head { display: flex; align-items: center; gap: 12px; padding: 20px 24px; border-bottom: 1px solid #ECEBF3; flex: 0 0 auto; }
  .doc-assistant__icon { width: 40px; height: 40px; border-radius: 12px; background: #EEEBFD; color: #6B56E2; display: flex; align-items: center; justify-content: center; }
  .doc-assistant__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 22px 24px; display: flex; flex-direction: column; gap: 22px; }
  .doc-assistant__foot { flex: 0 0 auto; border-top: 1px solid #ECEBF3; padding: 16px 24px 20px; display: flex; flex-direction: column; gap: 12px; }

  .doc-h3 { margin: 0 0 10px; font-size: 15px; font-weight: 600; color: #1A1535; }
  .doc-summary { margin: 0; font-size: 15px; line-height: 1.7; color: #4B5563; }
  .doc-facts { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .doc-fact { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border: 1px solid #ECEBF3; border-radius: 16px; background: #FAFAFC; }
  .doc-fact__n { width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid #D0C2F5; color: #6B56E2; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .doc-fact p { margin: 0; font-size: 14px; line-height: 1.65; color: #4B5563; }

  .chat-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chat-chip {
    min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid #E5E7EB; background: #fff;
    color: #4B5563; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.12s;
  }
  .chat-chip:hover { border-color: #6B56E2; color: #6B56E2; }
  .chat-input { display: flex; align-items: center; gap: 10px; border: 1.5px solid #E4E1FD; background: #FAFAFC; border-radius: 16px; padding: 6px 6px 6px 16px; transition: all 0.15s; }
  .chat-input:focus-within { border-color: #6B56E2; background: #fff; }
  .chat-input input { flex: 1; min-width: 0; height: 40px; border: none; outline: none; background: transparent; font-size: 14px; color: #1A1535; padding: 0; }
  .chat-send { width: 44px; height: 44px; border-radius: 10px; border: none; background: #6B56E2; color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  .chat-send:hover { background: #5B47D6; }

  @media (max-width: 991px) {
    .doc-columns { grid-template-columns: minmax(0, 1fr); }
    .doc-left { min-height: 0; }
    .doc-assistant { position: static; height: 640px; }
    .doc-stats { grid-template-columns: minmax(0, 1fr) !important; }
    .doc-stat + .doc-stat { border-left: none; border-top: 1px solid #ECEBF3; }
  }
</style>
