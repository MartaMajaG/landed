  .doc-fact { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border: 1px solid #ECEBF3; border-radius: 14px; background: #FCFCFE; }
  .doc-fact__n { width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid #C8BCF5; color: #6B56E2; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .doc-fact p { margin: 0; font-size: 14px; line-height: 1.65; color: #374151; }

  .chat-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chat-chip {
    min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid #E5E7EB; background: #fff;
    color: #374151; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.12s;
  }
  .chat-chip:hover { border-color: #6B56E2; color: #6B56E2; }
  .chat-input { display: flex; align-items: center; gap: 10px; border: 1.5px solid #E0D6F7; background: #F8F6FE; border-radius: 14px; padding: 6px 6px 6px 16px; transition: all 0.15s; }
  .chat-input:focus-within { border-color: #6B56E2; background: #fff; }
  .chat-input input { flex: 1; min-width: 0; height: 40px; border: none; outline: none; background: transparent; font-size: 14px; color: #1A1A2E; padding: 0; }
  .chat-send { width: 44px; height: 44px; border-radius: 10px; border: none; background: #6B56E2; color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
  .chat-send:hover { background: #5B47D6; }

  @media (max-width: 991px) {
    .doc-columns { grid-template-columns: minmax(0, 1fr); }
    .doc-left { min-height: 0; }
    .doc-assistant { position: static; height: 640px; }
    .doc-stats { grid-template-columns: minmax(0, 1fr) !important; }
    .doc-stat + .doc-stat { border-left: none; border-top: 1px solid #ECEBF3; }
  }
</style>

<div class="doc-page">
  <div class="container-xl doc-wrap">

    <%# ── BREADCRUMB ── %>
    <div class="task-breadcrumb-nav">
      <%= link_to "Dashboard", dashboard_path, class: "breadcrumb__link" %>
      <span class="breadcrumb__divider">›</span>
      <%= link_to "Documents", chats_path, class: "breadcrumb__link" %>
      <span class="breadcrumb__divider">›</span>
      <span class="breadcrumb__current" style="max-width:500px;"><%= english_title %></span>
    </div>

    <%# ── HEADER: what it is, how urgent, what to do, the numbers ── %>
    <section class="doc-card">
      <div class="doc-head">
        <div class="doc-head__top">
          <div>
            <div class="doc-tags">
              <span class="doc-tag doc-tag--brand"><%= mandatory ? "Mandatory" : "Optional" %></span>
              <% if doc_type.present? %><span class="doc-tag"><%= doc_type %></span><% end %>
              <span class="doc-processed">Processed <%= @chat.created_at.strftime("%b %-d, %Y") %></span>
            </div>
            <h1 class="doc-title"><%= english_title %></h1>
            <% if german_title.present? %><p class="doc-subtitle"><%= german_title %></p><% end %>
          </div>

          <div class="doc-actions">
            <% if @chat.deadline.present? %>
              <%
                default_reminder_date = days_left < 0 ? Date.today + 1 : @chat.deadline
                cal_title_r   = CGI.escape("Deadline: #{@chat.title}")
                cal_details_r = CGI.escape(@chat.title.to_s)
              %>
              <div style="position:relative;">
                <button type="button" class="doc-btn <%= primary_label ? 'doc-btn--secondary' : 'doc-btn--primary' %>"
                  onclick="const m=document.getElementById('rm-<%= @chat.id %>');m.style.display=m.style.display==='none'?'block':'none';event.stopPropagation();">
                  <span class="lucide-icon"><%= icon_cal_plus.html_safe %></span>
                  Remind me
                </button>
                <div id="rm-<%= @chat.id %>" style="display:none; position:absolute; top:calc(100% + 4px); right:0; background:#fff; border:1px solid #E5E7EB; border-radius:14px; box-shadow:0 12px 28px -12px rgba(107,86,226,0.30); min-width:240px; overflow:hidden; z-index:100;">
                  <div style="padding:12px 14px; border-bottom:1px solid #F3F4F6;">
                    <label for="reminder-date-<%= @chat.id %>" style="font-size:12px; font-weight:600; color:#6B7280; text-transform:uppercase; letter-spacing:0.04em; display:block; margin-bottom:6px;">Reminder date</label>
                    <input type="date" id="reminder-date-<%= @chat.id %>" value="<%= default_reminder_date.strftime("%Y-%m-%d") %>" style="width:100%; font-size:14px; border:1px solid #E5E7EB; border-radius:8px; padding:6px 8px; color:#1A1A2E;" onclick="event.stopPropagation()">
                  </div>
                  <a href="#" id="google-cal-link-<%= @chat.id %>" target="_blank" style="display:flex; align-items:center; gap:10px; padding:10px 14px; font-size:14px; color:#1A1A2E; text-decoration:none; border-bottom:1px solid #F3F4F6;"><span class="lucide-icon"><%= icon_cal_plus.html_safe %></span>Google Calendar</a>
                  <a href="#" id="outlook-link-<%= @chat.id %>" target="_blank" style="display:flex; align-items:center; gap:10px; padding:10px 14px; font-size:14px; color:#1A1A2E; text-decoration:none; border-bottom:1px solid #F3F4F6;"><span class="lucide-icon"><%= icon_cal_plus.html_safe %></span>Outlook</a>
                  <a href="#" id="apple-link-<%= @chat.id %>" style="display:flex; align-items:center; gap:10px; padding:10px 14px; font-size:14px; color:#1A1A2E; text-decoration:none;"><span class="lucide-icon"><%= icon_cal_plus.html_safe %></span>Apple Calendar</a>
                </div>
                <script>
                  document.addEventListener('click',function(){const m=document.getElementById('rm-<%= @chat.id %>');if(m)m.style.display='none';});
                  function updateReminderLinks<%= @chat.id %>() {
                    const dateVal = document.getElementById('reminder-date-<%= @chat.id %>').value;
                    const dateCompact = dateVal.replace(/-/g, '');
                    const title = "<%= cal_title_r %>";
                    const details = "<%= cal_details_r %>";
                    document.getElementById('google-cal-link-<%= @chat.id %>').href =
                      `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${dateCompact}/${dateCompact}&details=${details}`;
                    document.getElementById('outlook-link-<%= @chat.id %>').href =
                      `https://outlook.live.com/calendar/0/deeplink/compose?subject=${title}&startdt=${dateVal}&enddt=${dateVal}`;
                    document.getElementById('apple-link-<%= @chat.id %>').href =
                      `data:text/calendar;charset=utf8,${encodeURIComponent("BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nSUMMARY:<%= @chat.title %>\nDTSTART;VALUE=DATE:" + dateCompact + "\nDTEND;VALUE=DATE:" + dateCompact + "\nEND:VEVENT\nEND:VCALENDAR")}`;
                  }
                  document.getElementById('reminder-date-<%= @chat.id %>').addEventListener('change', updateReminderLinks<%= @chat.id %>);
                  updateReminderLinks<%= @chat.id %>();
                </script>
              </div>
            <% end %>

            <% if primary_label %>
              <button type="button" class="doc-btn doc-btn--primary" onclick="askAssistant<%= @chat.id %>('<%= j primary_question %>')">
                <span class="lucide-icon"><%= (primary_label == "How to pay" ? icon_card : icon_send).html_safe %></span>
                <%= primary_label %>
              </button>
            <% end %>
          </div>
        </div>

        <% if @chat.deadline.present? %>
          <div class="doc-banner doc-banner--<%= banner_tone %>">
            <div class="doc-banner__icon"><span class="lucide-icon doc-banner__svg"><%= (banner_tone == "calm" ? icon_cal_plus : icon_warn).html_safe %></span></div>
            <div>
              <p class="doc-banner__title"><%= banner_title %></p>
              <p class="doc-banner__text"><%= banner_text %></p>
            </div>
          </div>
        <% end %>
      </div>

      <% if stat_cells.any? %>
        <div class="doc-stats" style="grid-template-columns: repeat(<%= stat_cells.size %>, minmax(0, 1fr));">
          <% stat_cells.each do |cell| %>
            <div class="doc-stat">
              <p class="doc-stat__label"><%= cell[:label] %></p>
              <p class="doc-stat__value"><%= cell[:value] %></p>
              <% if cell[:sub].present? %><p class="doc-stat__sub"><%= cell[:sub] %></p><% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="doc-columns">

      <%# ── LEFT: the original document and your notes ── %>
      <section class="doc-card doc-left">
        <% if @chat.document.attached? %>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <h2 class="doc-section-title">Original document</h2>
            <%= link_to url_for(@chat.document), target: "_blank", class: "doc-link" do %>
              Open full size <%= icon_expand.html_safe %>
            <% end %>
          </div>
          <% if @chat.document.content_type.start_with?("image/") %>
            <%= link_to url_for(@chat.document), target: "_blank", class: "doc-peek", aria: { label: "Open the original document full size" } do %>
              <%= image_tag url_for(@chat.document), alt: "" %>
            <% end %>
          <% else %>
            <div class="doc-file">
              <span class="lucide-icon"><%= icon_file_red.html_safe %></span>
              <span><%= @chat.document.filename %></span>
            </div>
          <% end %>
        <% end %>

        <% if detail_rows.any? %>
          <div class="doc-details">
            <h3 class="doc-label">Details</h3>
            <dl>
              <% detail_rows.each do |row| %>
                <div class="doc-details__row">
                  <dt><%= row[:label].to_s.downcase.upcase_first %></dt>
                  <dd><%= row[:value] %><% if row[:sub].present? %><span> · <%= row[:sub] %></span><% end %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>

        <div class="doc-notes">
          <div class="doc-notes__head">
            <h3 class="doc-label">Your notes</h3>
            <button type="button" id="note-toggle-<%= @chat.id %>" class="doc-notes__add"
              onclick="document.getElementById('note-panel-<%= @chat.id %>').classList.toggle('open'); document.getElementById('note-input-<%= @chat.id %>').focus();">
              <span class="lucide-icon"><%= icon_plus.html_safe %></span> Add note
            </button>
          </div>
          <div id="note-panel-<%= @chat.id %>" class="note-panel">
            <label for="note-input-<%= @chat.id %>" class="visually-hidden">Note</label>
            <textarea id="note-input-<%= @chat.id %>" class="note-textarea" rows="3" placeholder="e.g. Paid by bank transfer on Monday, kept the receipt"></textarea>
            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:8px;">
              <button type="button" style="font-size:14px; font-weight:500; color:#4B5563; padding:8px 14px; border:1px solid #E5E7EB; border-radius:10px; background:transparent; cursor:pointer;" onclick="closeNotePanel('<%= @chat.id %>')">Cancel</button>
              <button type="button" style="font-size:14px; font-weight:600; color:#fff; padding:8px 14px; border:none; border-radius:10px; background:#6B56E2; cursor:pointer; display:flex; align-items:center; gap:6px;" onclick="saveNote('<%= @chat.id %>')">
                <span class="lucide-icon"><%= icon_check.html_safe %></span> Save note
              </button>
            </div>
          </div>
          <div id="note-list-<%= @chat.id %>" class="doc-notes__list"></div>
          <p class="doc-notes__empty">No notes yet. Add one to keep track of what you did, like when you paid or who you spoke to.</p>
        </div>
      </section>

      <%# ── RIGHT: AI assistant, stays in view while scrolling ── %>
      <section class="doc-card doc-assistant" id="chat-card-<%= @chat.id %>" aria-label="AI Assistant">
        <header class="doc-assistant__head">
          <div class="doc-assistant__icon"><span class="lucide-icon"><%= icon_sparkle.html_safe %></span></div>
          <div>
            <h2 class="doc-section-title">AI Assistant</h2>
            <p style="margin:2px 0 0; font-size:14px; color:#6B7280;">Ask anything about this document</p>
          </div>
        </header>

        <div class="doc-assistant__body" id="chat-messages-<%= @chat.id %>">
          <% if adv["explanation"].present? || adv["summary"].present? %>
            <div>
              <h3 class="doc-h3">What this means</h3>
              <% summary_text = adv["explanation"].present? ? adv["explanation"].split(/(?<=[.!?])\s+/).first(2).join(" ") : adv["summary"] %>
              <p class="doc-summary"><%= highlight_values(summary_text) %></p>
            </div>
          <% end %>

          <% if adv["key_facts"].present? %>
            <div>
              <h3 class="doc-h3">What to watch out for</h3>
              <ol class="doc-facts">
                <% adv["key_facts"].each_with_index do |fact, i| %>
                  <li class="doc-fact">
                    <span class="doc-fact__n"><%= fact["n"] || i + 1 %></span>
                    <p><%= highlight_values(fact["text"]) %></p>
                  </li>
                <% end %>
              </ol>
            </div>
          <% end %>

          <% if @chat.description.present? %>
            <div>
              <h3 class="doc-h3">Next steps</h3>
              <ul style="font-size:14px; color:#374151; line-height:1.7; padding-left:18px; margin:0;">
                <% @chat.description.split("\n").reject(&:blank?).each do |step| %>
                  <li style="margin-bottom:6px;"><%= step.gsub(/^[-•\d.]\s*/,"").strip %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if @chat.messages.exists? %>
            <p class="doc-label" style="padding-top:14px; border-top:1px solid #ECEBF3;">Conversation</p>
          <% end %>

          <% @chat.messages.order(:created_at).each do |message| %>
            <% if message.role == "user" %>
              <div style="display:flex; justify-content:flex-end;">
                <div style="background:#6B56E2; color:#fff; font-size:14px; line-height:1.6; padding:10px 14px; border-radius:18px 4px 18px 18px; max-width:75%;"><%= message.content %></div>
              </div>
            <% else %>
              <%= render "messages/ai_bubble", content: message.content %>
            <% end %>
          <% end %>
        </div>

        <div class="doc-assistant__foot">
          <% if questions.any? %>
            <div class="chat-chips">
              <% questions.each do |question| %>
                <button type="button" class="chat-chip" data-question="<%= question %>" onclick="var input = document.getElementById('chat-input-<%= @chat.id %>'); input.value = this.dataset.question; input.focus();"><%= question %></button>
              <% end %>
            </div>
          <% end %>
          <%= form_with url: chat_messages_path(@chat), method: :post, id: "chat-form-#{@chat.id}", data: { controller: "chat-form", action: "submit->chat-form#disableSubmit" } do |f| %>
            <div class="chat-input">
              <label for="chat-input-<%= @chat.id %>" class="visually-hidden">Ask about this document</label>
              <%= f.text_field :message, name: "message[content]", id: "chat-input-#{@chat.id}", placeholder: "Ask anything about this document…", autocomplete: "off", required: true %>
              <button type="submit" class="chat-send" aria-label="Send">
                <span class="lucide-icon"><%= icon_send.html_safe %></span>
              </button>
            </div>
          <% end %>
        </div>
      </section>

    </div>
  </div>
</div>

<script>
  // "How to pay" asks the assistant directly
  function askAssistant<%= @chat.id %>(question) {
    const input = document.getElementById('chat-input-<%= @chat.id %>');
    const form  = document.getElementById('chat-form-<%= @chat.id %>');
    input.value = question;
    form.requestSubmit();
    document.getElementById('chat-card-<%= @chat.id %>').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function closeNotePanel(chatId) {
    document.getElementById('note-panel-' + chatId).classList.remove('open');
    document.getElementById('note-input-' + chatId).value = '';
  }

  function saveNote(chatId) {
    const input = document.getElementById('note-input-' + chatId);
    const text = input.value.trim();
    if (!text) return;

    const list = document.getElementById('note-list-' + chatId);
    const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const noteId = 'note-' + Date.now();

    const item = document.createElement('div');
    item.className = 'note-item';
    item.id = noteId;

    const body = document.createElement('div');
    const p = document.createElement('p');
    p.className = 'note-item-text';
    p.textContent = text;
    const meta = document.createElement('p');
    meta.className = 'note-item-meta';
    meta.textContent = 'Today at ' + now;
    body.append(p, meta);

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'note-delete-btn';
    del.setAttribute('aria-label', 'Delete note');
    del.innerHTML = '<span class="lucide-icon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg></span>';
    del.onclick = () => item.remove();

    item.append(body, del);
    list.appendChild(item);
    closeNotePanel(chatId);
  }

</script>
