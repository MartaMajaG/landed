  .doc-details dt { font-size: 12px; font-weight: 500; color: #6B7280; margin: 0 0 2px; }
  .doc-details dd { margin: 0; font-size: 14px; font-weight: 600; color: #1A1A2E; line-height: 1.5; }
  .doc-details dd span { font-weight: 400; color: #6B7280; }
  .doc-notes { border-top: 1px solid #ECEBF3; padding-top: 6px; }
  .doc-notes__head { display: flex; justify-content: space-between; align-items: center; }
  .doc-label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6B7280; }
