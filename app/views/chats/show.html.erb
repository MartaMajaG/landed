  .doc-notes__empty { margin: 0; font-size: 14px; color: #4B5563; line-height: 1.6; }
  .doc-notes__list:not(:empty) + .doc-notes__empty { display: none; }

  .note-panel { display: none; margin-top: 8px; border: 1px solid #6B56E2; border-radius: 14px; padding: 12px; background: #fff; }
  .note-panel.open { display: block; }
  .note-textarea {
    width: 100%; font-size: 14px; font-family: inherit; color: #1A1A2E; background: #F5F2FD;
    border: 1px solid #E0D6F7; border-radius: 12px; padding: 9px 12px; resize: none; line-height: 1.6; outline: none;
  }
  .note-textarea:focus { border-color: #6B56E2; background: #fff; }
  .note-item {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
    padding: 10px 12px; margin-top: 8px; background: #F5F2FD; border-radius: 12px; border: 1px solid #EEEBFD;
  }
  .note-item-text { font-size: 14px; color: #1A1A2E; line-height: 1.6; margin: 0; }
