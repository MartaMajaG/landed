  .note-delete-btn { background: none; border: none; cursor: pointer; color: #9CA3AF; padding: 4px; flex-shrink: 0; }
  .note-delete-btn:hover { color: #B42318; }

  /* Assistant: stays in view while the page scrolls */
  .doc-assistant {
    position: sticky; top: 24px; height: calc(100vh - 48px); min-height: 520px;
    display: flex; flex-direction: column; overflow: hidden;
