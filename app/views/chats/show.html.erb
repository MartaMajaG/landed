<%
  adv       = @chat.advice.present? ? @chat.parsed_advice : {}
  show_pay  = @chat.amount.to_f > 0
  mandatory = @chat.is_mandatory? || @chat.is_mandatory.nil?
  doc_type  = @chat.document_type.to_s.split("/").first.to_s.strip

  # Deadline state, shown once in the banner
  if @chat.deadline.present?
    days_left = (@chat.deadline - Date.today).to_i
    due_on    = @chat.deadline.strftime("%b %-d, %Y")
    if days_left < 0
      banner_tone  = "overdue"
      banner_title = "Overdue since #{@chat.deadline.strftime('%B %Y')}"
      banner_text  = show_pay ? "Payment was due on #{due_on}. Paying soon helps you avoid extra fees." : "This was due on #{due_on}. It's worth acting on it as soon as you can."
    elsif days_left == 0
      banner_tone, banner_title, banner_text = "soon", "Due today", "The deadline is #{due_on}."
    elsif days_left <= 14
      banner_tone, banner_title, banner_text = "soon", "Due in #{days_left} #{'day'.pluralize(days_left)}", "The deadline is #{due_on}."
    else
      banner_tone, banner_title, banner_text = "calm", "Due #{due_on}", "You have #{days_left} days."
    end
  end

  # Stat strip: the amount plus up to two extra facts from the analysis.
  # Amount and deadline stats from the AI are skipped, they're shown elsewhere.
  vague = ["unknown","varies","n/a","none","tbd","variable","see document"]
  money_or_date = /fee|amount|cost|payment|price|gebühr|owed|deadline|due|date/
  amount_stat = adv["stats"]&.find { |s| s["label"].to_s.downcase.match?(/fee|amount|cost|payment|price|gebühr|owed/) }
  extra_stats = (adv["stats"] || []).reject { |s|
    vague.include?(s["value"].to_s.downcase.strip) || s["label"].to_s.downcase.match?(money_or_date)
  }.first(2)

  stat_cells = []
  if @chat.amount.present? && @chat.amount != 0
    if @chat.amount < 0
      stat_cells << { label: "Potential refund", value: "€#{number_with_precision(@chat.amount.abs, precision: 2)}", sub: "You may receive this back" }
    else
      stat_cells << { label: "Amount owed", value: "€#{number_with_precision(@chat.amount, precision: 2)}", sub: amount_stat&.dig("sub").presence || "Payment required" }
    end
  end
  # Short numeric facts (€32,597, 2019, 30 days) go in the big stat strip.
  # Text facts (an authority, a list of data) go in the Details list on the left.
  detail_rows = []
  extra_stats.each do |s|
    raw = s["value"].to_s
    value = raw.match?(/\A[\d.,]+\s*€\z/) ? "€#{raw.gsub(/\s*€/, '').strip}" : raw
    if value.match?(/\d/) && value.length <= 14
      stat_cells << { label: s["label"], value: value, sub: s["sub"] }
    else
      detail_rows << { label: s["label"], value: value, sub: s["sub"] }
    end
  end

  # Main action depends on the kind of document: applications get submitted, bills get paid.
  doc_text = "#{@chat.document_type} #{@chat.title}".downcase
  if doc_text.match?(/applica|antrag|form\b|registration|anmeldung/)
    primary_label, primary_question = "How to apply", "How do I submit this application?"
  elsif show_pay
    primary_label, primary_question = "How to pay", "How do I pay this?"
  end

  questions = document_questions(@chat, skip: [primary_question].compact)
%>

<%
  # Extracted values (wrapped in ** by the AI) are bold indigo everywhere on this page
  def highlight_values(text)
    escaped = ERB::Util.html_escape(text).to_str
    escaped = escaped.gsub(/\*\*\s*(.+?)\s*\*\*/, '<strong class="doc-value">\1</strong>').gsub("**", "")
    escaped.html_safe
  end
%>

<style>
  .lucide-icon { display: inline-flex; align-items: center; flex-shrink: 0; }
  .ai-reply p { margin: 0 0 8px; }
  .ai-reply p:last-child { margin-bottom: 0; }

  .doc-page { padding: 24px 0 40px; }
  .doc-wrap { max-width: 1240px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

  .doc-card {
    background: #fff; border: 1px solid #ECEBF3; border-radius: 20px;
    box-shadow: 0 4px 14px -10px rgba(91,80,232,0.35);
  }
  .doc-value { color: #4433B8; font-weight: 600; }

  /* Header */
  .doc-head { padding: 28px 32px 24px; display: flex; flex-direction: column; gap: 20px; }
  .doc-head__top { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .doc-tags { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .doc-tag { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: #F1F1F5; color: #374151; }
  .doc-tag--brand { background: #EEEBFD; color: #4433B8; }
  .doc-processed { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6B7280; margin-left: 4px; }
  .doc-title { margin: 0; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: 32px; font-weight: 700; letter-spacing: -0.5px; line-height: 1.15; color: #1A1A2E; }
  .doc-subtitle { margin: 8px 0 0; font-size: 14px; color: #6B7280; font-style: italic; }

  .doc-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .doc-btn {
    height: 44px; padding: 0 16px; border-radius: 10px; font-size: 14px; font-weight: 600;
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; transition: background 0.15s ease;
  }
  .doc-btn--secondary { border: 1px solid #DCD5FA; background: #F6F4FE; color: #4433B8; }
  .doc-btn--secondary:hover { background: #ECE8FD; }
  .doc-btn--primary { border: none; background: #6B56E2; color: #fff; padding: 0 18px; }
  .doc-btn--primary:hover { background: #5B47D6; }

  /* Deadline banner */
  .doc-banner { display: flex; align-items: center; gap: 14px; border-radius: 14px; padding: 14px 18px; border: 1px solid; }
  .doc-banner__icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .doc-banner__svg svg { width: 18px; height: 18px; }
  .doc-banner__title { margin: 0; font-size: 15px; font-weight: 600; }
  .doc-banner__text { margin: 2px 0 0; font-size: 14px; }
  .doc-banner--overdue { background: #FEF3F2; border-color: #FBD5D1; }
  .doc-banner--overdue .doc-banner__icon { background: #FDE4E1; color: #B42318; }
  .doc-banner--overdue .doc-banner__title { color: #912018; }
  .doc-banner--overdue .doc-banner__text { color: #7A271A; }
  .doc-banner--soon { background: #FFFAEB; border-color: #FDE7B0; }
  .doc-banner--soon .doc-banner__icon { background: #FEF0C7; color: #B54708; }
  .doc-banner--soon .doc-banner__title { color: #93370D; }
  .doc-banner--soon .doc-banner__text { color: #7A2E0E; }
  .doc-banner--calm { background: #F8F6FE; border-color: #E6E0FB; }
  .doc-banner--calm .doc-banner__icon { background: #EEEBFD; color: #4433B8; }
  .doc-banner--calm .doc-banner__title { color: #1A1A2E; }
  .doc-banner--calm .doc-banner__text { color: #4B5563; }

  /* Stat strip */
  .doc-stats { display: grid; border-top: 1px solid #ECEBF3; background: #FCFCFE; border-radius: 0 0 20px 20px; }
  .doc-stat { padding: 20px 32px; display: flex; flex-direction: column; gap: 6px; }
  .doc-stat + .doc-stat { border-left: 1px solid #ECEBF3; }
  .doc-stat__label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6B7280; }
  .doc-stat__value { margin: 0; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: 28px; font-weight: 700; letter-spacing: -0.4px; color: #1A1A2E; }
  .doc-stat__sub { margin: 0; font-size: 14px; color: #4B5563; }

  /* Two columns */
  .doc-columns { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px; align-items: start; }
  .doc-section-title { margin: 0; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: 17px; font-weight: 700; color: #1A1A2E; }
  .doc-link { font-size: 14px; font-weight: 600; color: #6B56E2; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .doc-link:hover { color: #4433B8; }

  .doc-left { padding: 24px; display: flex; flex-direction: column; gap: 20px; box-sizing: border-box; }
  .doc-peek {
    display: block; position: relative; height: 260px; overflow: hidden;
    background: #fff; border: 1px solid #ECEBF3; border-radius: 14px;
  }
  .doc-peek img { width: 100%; height: auto; display: block; transition: transform 0.3s ease; }
  .doc-peek::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 90px;
    background: linear-gradient(to bottom, rgba(255,255,255,0), #fff);
  }
  .doc-peek:hover img { transform: translateY(-6px); }
  .doc-file { background: #F7F6FB; border: 1px solid #ECEBF3; border-radius: 14px; min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #4B5563; font-size: 14px; }

  .doc-details { border-top: 1px solid #ECEBF3; padding-top: 16px; }
