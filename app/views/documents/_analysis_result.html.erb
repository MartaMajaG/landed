<%# Partial to display the AI analysis results %>
<%# match contains: { matched_type: Object, confidence_score: Int, target_logic: Hash } %>

<div class="analysis-result-card"
     id="analysis_result_<%= match[:matched_type]&.id %>"
     data-controller="smart-actions"
     data-smart-actions-type-value="<%= match[:target_logic]['action_type'] %>"
     data-smart-actions-url-value="<%= match[:target_logic]['target_url'] %>"
     data-smart-actions-task-id-value="<%= match[:target_logic]['completes_task_id'] %>">

  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <span class="category-pill <%= match[:matched_type]&.category == 'legal' ? 'category-pill--legal' : 'category-pill--neutral' %>">
        <%= match[:matched_type]&.category&.upcase || "UNCATEGORIZED" %>
      </span>
      <h3 class="analysis-result-title"><%= match[:matched_type]&.name || "Unknown document" %></h3>
      <p class="analysis-result-confidence">Identification confidence: <%= (match[:confidence_score] * 20).to_i %>%</p>
    </div>

    <span class="lucide-icon analysis-result-check"><%= inline_svg_icon("circle-check") %></span>
  </div>

  <% if match[:target_logic].present? %>
    <button type="button"
            class="smart-action-btn"
            data-action="click->smart-actions#perform">
      <span class="lucide-icon"><%= inline_svg_icon("bolt") %></span>
      <%= match[:target_logic]['action_type'].titleize %>
    </button>
  <% end %>

  <div class="analysis-result-footer">
    <span class="lucide-icon"><%= inline_svg_icon("link") %></span>
    <span>Links to checklist task: <strong><%= match[:target_logic]['completes_task_id'] || "None" %></strong></span>
  </div>
</div>
