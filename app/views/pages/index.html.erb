<% content_for :meta_title, "Landed | Your move to Germany, sorted" %>

<% pillars = [
  ["housing_and_registration", "Housing & registration"],
  ["finance_and_banking",      "Finance & banking"],
  ["legal_and_work",           "Legal & work"],
  ["health_and_insurance",     "Health & insurance"]
] %>

<%= render "chats/document_styles" %>

<div class="lp" data-controller="landing">
  <header class="lp-nav">
    <%= link_to root_path, class: "lp-brand" do %>
      <%= render "shared/logo", size: 24 %>
    <% end %>
    <nav class="lp-nav__links">
      <a href="#how" class="lp-nav__link">How it works</a>
      <%= link_to "Sign in", new_user_session_path, class: "lp-nav__link" %>
      <%= link_to "Get started", new_user_registration_path, class: "lp-btn lp-btn--sm" %>
    </nav>
  </header>

  <%# ── HERO ── %>
  <section class="lp-hero">
    <div class="lp-hero__inner">
      <div class="lp-hero__copy">
        <h1 class="lp-hero__title lp-rise" style="--d: 0ms">The relocation companion that moves with you.</h1>
        <p class="lp-hero__lede lp-rise" style="--d: 200ms">Tell Landed where you're moving and when you arrive. It turns German bureaucracy into a dated checklist, and explains the official letters you can't read yet.</p>
        <div class="lp-hero__actions lp-rise" style="--d: 300ms">
          <%= link_to new_user_registration_path, class: "lp-btn lp-btn--light" do %>
            Get started <%= lucide_icon("arrow_right", size: 16) %>
          <% end %>
          <a href="#how" class="lp-btn lp-btn--on-dark">See how it works</a>
        </div>
      </div>
      <div class="lp-hero__art">
        <%= render "pages/hero_scene" %>
      </div>
    </div>
  </section>

  <%# ── PRODUCT ── %>
  <section class="lp-product" data-landing-target="reveal">
    <div class="lp-product__copy">
      <h2>Your whole move on one board</h2>
      <p>Every task is dated from your arrival and sorted by what's urgent. Steps open in the right order, and when a German letter arrives, its deadline shows up next to everything else.</p>
      <ul class="lp-hero__pillars" aria-label="What Landed covers">
        <% pillars.each do |slug, name| %>
          <li class="lp-pillar"><%= pillar_chip_for(slug, name) %></li>
        <% end %>
      </ul>
    </div>

    <%# Product preview built from the real dashboard and document components:
        kanban columns + task cards (dashboards/_kanban) and the document header card (chats/show) %>
    <div class="lp-demo" aria-hidden="true" data-landing-target="demo">
      <div class="lp-demo__window">
        <div class="tasks-header">
          <div class="tasks-title-group"><h2 class="tasks-label">Tasks</h2></div>
          <div class="tasks-toggle">
            <button class="toggle-btn active" tabindex="-1">Open Tasks</button>
            <button class="toggle-btn" tabindex="-1">Completed</button>
          </div>
        </div>

        <div class="kanban">
          <div class="kanban-col">
            <div class="col-header urgent-header">
              <span class="col-dot urgent-dot"></span>
              <span class="col-title">Urgent</span>
              <span class="col-count">2</span>
            </div>
            <div class="lp-demo__progress">
              <%= render "pages/demo_task_card", slug: "housing_and_registration", pillar: "Housing & Registration",
                    name: "Registration (Anmeldung)", desc: "Register your address with the local authorities to obtain your Meldebescheinigung.",
                    done: 0, total: 6, due: "Tomorrow", urgent: true %>
            </div>
            <%= render "pages/demo_task_card", slug: "health_and_insurance", pillar: "Health & Insurance",
                  name: "Health Insurance (Krankenversicherung)", desc: "Choose between public (GKV) and private (PKV) health insurance and complete your enrolment before starting work.",
                  done: 1, total: 5, due: "Nov 08", urgent: true %>
          </div>

          <div class="kanban-col">
            <div class="col-header active-header">
              <span class="col-dot active-dot"></span>
              <span class="col-title">Active</span>
              <span class="col-count">2</span>
            </div>
            <div class="lp-demo__hover">
              <%= render "pages/demo_task_card", slug: "finance_and_banking", pillar: "Finance & Banking",
                    name: "Banking", desc: "Open a German bank account to receive your salary and pay bills locally.",
                    done: 0, total: 4, due: "Nov 21", urgent: false %>
            </div>
            <%= render "pages/demo_task_card", slug: "housing_and_registration", pillar: "Housing & Registration",
                  name: "Set Up Household Utilities", desc: "Register for the broadcasting fee, set up your electricity contract, and arrange your internet connection.",
                  done: 2, total: 5, due: "Nov 21", urgent: false %>
          </div>
        </div>
      </div>

      <%# Document header card from the scanner page, with the "due soon" banner %>
      <div class="doc-card lp-demo__doc">
        <div class="doc-head">
          <div>
            <div class="doc-tags">
              <span class="doc-tag doc-tag--brand">Mandatory</span>
              <span class="doc-tag">Rental contract</span>
            </div>
            <h1 class="doc-title">Rental agreement</h1>
            <p class="doc-subtitle">Mietvertrag</p>
          </div>
          <div class="doc-banner doc-banner--soon">
            <div class="doc-banner__icon"><span class="lucide-icon doc-banner__svg"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span></div>
            <div>
              <p class="doc-banner__title">Deposit due in 5 days</p>
              <p class="doc-banner__text">Transfer €3,720 to your landlord by Nov 15.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ── HOW IT WORKS ── %>
  <section class="lp-how" id="how" data-landing-target="reveal">
    <div class="lp-section-head">
      <h2>From arrival to settled in three steps</h2>
      <p>Most of the work in a move to Germany is knowing what comes first. Landed works that out for you.</p>
    </div>

    <ol class="lp-steps">
      <li class="lp-step">
        <span class="lp-step__num">1</span>
        <span class="lp-step__icon"><%= lucide_icon("pin", size: 20) %></span>
        <h3>Tell us about your move</h3>
        <p>Four quick questions: your city, arrival date, visa and whether you have a flat yet.</p>
      </li>
      <li class="lp-step">
        <span class="lp-step__num">2</span>
        <span class="lp-step__icon"><%= lucide_icon("list", size: 20) %></span>
        <h3>Follow your checklist</h3>
        <p>Every task is dated from your arrival and opens in the right order, so you never book the bank before the Anmeldung.</p>
      </li>
      <li class="lp-step">
        <span class="lp-step__num">3</span>
        <span class="lp-step__icon"><%= lucide_icon("scan", size: 20) %></span>
        <h3>Scan what lands in your mailbox</h3>
        <p>Upload a German letter and get the key facts, the deadline and what to do next, in English.</p>
      </li>
    </ol>
  </section>

  <%# ── DOCUMENT SCANNER ── %>
  <section class="lp-scanner" data-landing-target="reveal">
    <div class="lp-scanner__copy">
      <h2>Understand a German letter in about a minute</h2>
      <p>Rental contracts, tax notices, insurance letters. Landed reads them, pulls out what matters and answers your follow-up questions in the same thread.</p>
      <div class="lp-stat">
        <b>80%</b>
        <span>faster than testers' usual way of decoding a German document, like a translation app or a bilingual friend</span>
      </div>
    </div>

    <%# The AI Assistant panel from the document page (chats/show), with an example rental contract %>
    <section class="doc-card doc-assistant lp-assistant" aria-hidden="true">
      <header class="doc-assistant__head">
        <div class="doc-assistant__icon"><span class="lucide-icon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/></svg></span></div>
        <div>
          <h2 class="doc-section-title">AI Assistant</h2>
          <p style="margin:2px 0 0; font-size:14px; color:#6B7280;">Ask anything about this document</p>
        </div>
      </header>

      <div class="doc-assistant__body">
        <div class="lp-seq" style="--d: .15s">
          <h3 class="doc-h3">What this means</h3>
          <p class="doc-summary">This is your rental agreement for the flat in Schwabing. Rent is <strong class="doc-value">€1,240 per month</strong>, and the contract runs with no end date.</p>
        </div>

        <div class="lp-seq" style="--d: .5s">
          <h3 class="doc-h3">What to watch out for</h3>
          <ol class="doc-facts">
            <li class="doc-fact"><span class="doc-fact__n">1</span><p>The deposit of <strong class="doc-value">€3,720</strong> is due by <strong class="doc-value">Nov 15</strong>.</p></li>
            <li class="doc-fact"><span class="doc-fact__n">2</span><p>Either side can end the lease with <strong class="doc-value">3 months' notice</strong>.</p></li>
          </ol>
        </div>

        <p class="doc-label lp-seq" style="--d: 1s; padding-top:14px; border-top:1px solid #ECEBF3;">Conversation</p>

        <div class="lp-seq" style="--d: 1.3s; display:flex; justify-content:flex-end;">
          <div style="background:#6B56E2; color:#fff; font-size:14px; line-height:1.6; padding:10px 14px; border-radius:18px 4px 18px 18px; max-width:75%;">Can I pay the deposit in parts?</div>
        </div>

        <div class="lp-seq" style="--d: 2s">
          <%= render "messages/ai_bubble", content: "Yes. German law lets you pay a rental deposit in **three monthly instalments**, with the first one due when the lease starts." %>
        </div>
      </div>

      <div class="doc-assistant__foot">
        <div class="chat-chips">
          <button type="button" class="chat-chip" tabindex="-1">When is the deposit due?</button>
          <button type="button" class="chat-chip" tabindex="-1">How do I give notice?</button>
        </div>
        <div class="chat-input">
          <input type="text" placeholder="Ask anything about this document…" tabindex="-1" readonly>
          <button type="button" class="chat-send" tabindex="-1">
            <span class="lucide-icon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></span>
          </button>
        </div>
      </div>
    </section>
  </section>

  <%# ── CTA ── %>
  <section class="lp-cta" data-landing-target="reveal">
    <div>
      <h2>Sort your move before you land</h2>
      <p>Answer four questions and your checklist is ready.</p>
    </div>
    <%= link_to new_user_registration_path, class: "lp-btn lp-btn--light" do %>
      Get started <%= lucide_icon("arrow_right", size: 16) %>
    <% end %>
  </section>

  <footer class="lp-footer">
    <span class="lp-brand lp-brand--small"><%= render "shared/logo", size: 18 %></span>
    <span>Made in Berlin for people moving to Germany.</span>
  </footer>
</div>
